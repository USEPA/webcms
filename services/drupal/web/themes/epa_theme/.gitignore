# OS generated files
.DS_Store

# Node dependencies (Keep ignored: we do not want these in the repo)
node_modules

# Build caches and IDE configurations (Keep ignored)
.sass-cache
dependencyGraph.json
.vscode
.idea

# Pattern Lab static site generator (Keep ignored: Drupal does not use this)
pattern-lab

# Source artifact files (Keep ignored: These are intermediate files used 
# during the local Gulp build process, but Drupal itself does not need them)
source/_data/design-tokens.artifact.yml
source/_patterns/00-config/_design-tokens.artifact.scss
source/_patterns/00-config/_uswds-theme.artifact.scss
source/_patterns/_uswds-theme-settings.artifact.scss

